{
  "manifest_version": 3,
  "name": "Claude Limit Closer",
  "version": "1.3",
  "description": "Clicks Continue in paused Claude chats, and closes the Chrome window when the free limit reset time is shown.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
