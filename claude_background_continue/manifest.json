{
  "manifest_version": 3,
  "name": "Claude Background Continue",
  "version": "1.5.0",
  "description": "Automatically checks Claude chats in the sidebar for usage-limit Continue or Try again actions.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Continue Scanner"
  }
}
